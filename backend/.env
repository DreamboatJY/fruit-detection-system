# 应用基本配置
APP_NAME=Fruit and Vegetable Detection System
APP_VERSION=1.0.0
DEBUG=true

# PostgreSQL数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=rsod_user
DB_PASSWORD=rsod_password
DB_NAME=rsod_db

# Redis缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO对象存储配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rsod-bucket
MINIO_SECURE=false

# YOLO目标检测模型配置
YOLO_MODEL_PATH=models/yolo11n.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# 文件存储配置
UPLOAD_DIR=uploads
RESULT_DIR=results